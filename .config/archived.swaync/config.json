{
  "_comment": "base file is from https://github.com/thomasmartinoa/hypr-dotfiles/tree/main",
  "positionX": "right",
  "positionY": "top",
  "cssPriority": "user",
  "control-center-width": 310,
  "control-center-height": 900,
  "control-center-margin-top": 40,
  "control-center-margin-bottom": 0,
  "control-center-margin-right": 10,
  "control-center-margin-left": 0,
  "notification-window-width": 400,
  "notification-icon-size": 48,
  "notification-body-image-height": 160,
  "notification-body-image-width": 200,
  "timeout": 4,
  "timeout-low": 2,
  "timeout-critical": 6,
  "fit-to-screen": false,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": false,
  "script-fail-notify": true,
  "widgets": [
    "label",
    "buttons-grid",
    "menubar",
    "backlight",
    "volume",
    "mpris",
    "title",
    "dnd",
    "notifications"
  ],
  "widget-config": {
    "notifications": {},
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": " 󰎟 "
    },
    "dnd": {
      "text": "Do not disturb"
    },
    "label": {
      "max-lines": 1,
      "text": " "
    },
    "mpris": {
      "image-size": 0,
      "image-radius": 12,
      "blur": true,
      //"show-player": "all",
      "show-when-paused": true
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": true,
      "show-per-app-icon": true,
      "show-per-app-label": false,
      "expand-button-label": " 󰅀",
      "collapse-button-label": " 󰅃",
      "image-size": 56
    },
    "backlight": {
      "label": "󰛩",
      "device": "amdgpu_bl1",
      "subsystem": "backlight"
    },
    "buttons-grid": {
      "actions": [
        {
          "label": " Volume",
          "type": "toggle",
          "active": true,
          "command": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
          "update-command": "wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED && echo false || echo true"
        },
        {
          "label": " Microphone",
          "type": "toggle",
          "active": true,
          "command": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
          "update-command": "wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED && echo false || echo true"
        },
        {
          "label": "󰖩 Wifi",
          "type": "toggle",
          "active": true,
          "command": "nmcli radio wifi | grep -q enabled && nmcli radio wifi off || nmcli radio wifi on",
          "update-command": "nmcli radio wifi | grep -q enabled && echo true || echo false"
        },
        {
          "label": "󰂯 Bluetooth",
          "type": "toggle",
          "active": true,
          "command": "rfkill list bluetooth | grep -q 'Soft blocked: yes' && rfkill unblock bluetooth || rfkill block bluetooth",
          "update-command": "[[ $(rfkill list bluetooth | grep 'Soft blocked' | awk '{print $3}') == no ]] && echo false || echo true"
        },
        {
          "label": "󰀝 Airplane Mode",
          "type": "toggle",
          "active": false,
          "command": "nmcli networking | grep -q enabled && nmcli networking off || nmcli networking on",
          "update-command": "nmcli networking | grep -q disabled && echo true || echo false"
        }
      ]
    },
    "menubar": {
      "menu#power-profile": {
        "label": "󰊴 Power Profile",
        "position": "left",
        "actions": [
          {
            "label": "󰓅  Performance",
            "command": "sudo tlp ac"
          },
          {
            "label": "󰾅  Balanced",
            "command": "sudo tlp bat"
          },
          {
            "label": "󰾆  TLP Start",
            "command": "sudo tlp start"
          }
        ]
      },
      "menu#power": {
        "label": "󰐥 Power Menu",
        "position": "right",
        "actions": [
          {
            "label": "󰌾  Lock",
            "command": "hyprlock"
          },
          {
            "label": "󰗽  Logout",
            "command": "hyprctl dispatch exit"
          },
          {
            "label": "󰜉  Reboot",
            "command": "systemctl reboot"
          },
          {
            "label": "󰐥  Shutdown",
            "command": "systemctl poweroff"
          }
        ]
      }
    }
  }
}