{
	"clock": {
		"interval": 60,
		"format": "{:%H:%M   %a %d %b}",
		"on-click": "",
		"tooltip-format": "<tt><small>{calendar}</small></tt>",
		"calendar": {
			"mode": "year",
			"mode-mon-col": 3,
			"weeks-pos": "right",
			"first-day-of-week": 1,
			"on-scroll": 1,
			"on-click-right": "mode",
			"format": {
				"months": "<span color='#83a598'><b>{}</b></span>", // grv-bright-blue
				"days": "<span color='#ebdbb2'><b>{}</b></span>", // grv-fg1
				"weeks": "<span color='#8ec07c'><b>W{}</b></span>", // grv-bright-aqua
				"weekdays": "<span color='#fabd2f'><b>{}</b></span>", // grv-yellow / grv-active
				"today": "<span color='#fb4934'><b><u>{}</u></b></span>" // grv-critical / grv-bright-red
			}
		},
		"actions": {
			"on-click-right": "mode",
			"on-click-forward": "tz_up",
			"on-click-backward": "tz_down",
			"on-scroll-up": "shift_up",
			"on-scroll-down": "shift_down"
		}
	}
}