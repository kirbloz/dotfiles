{
    "custom/notification": {
        "icon-size": 18,
        "format": "{icon} {0}",
        "format-none": "{icon}",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂜",
            "dnd-notification": "󰂠",
            "dnd-none": "󰪓",
            "inhibited-notification": "󰂛",
            "inhibited-none": "󰪑",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰪑"
        },
        "tooltip": false,
        "on-click": "swaync-client -t sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true,
        "return-type": "json",
        "exec": "swaync-client -swb",
        "exec-if": "which swaync-client"
    }
}