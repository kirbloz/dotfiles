{
  "custom/brightness": {
    "format": "\uf042 {percentage}%",
    //"format-icons": ["󰃞", "󰃟", "󰃠"],
    "exec": "~/.config/waybar/scripts/brightness.sh",
    "return-type": "json",
    "interval": 2,
    "signal": 9,
    "on-click": "~/.config/waybar/scripts/brightness-menu.sh",
    "on-scroll-up": "~/.local/bin/brightness up-all && pkill -RTMIN+9 waybar",
    "on-scroll-down": "~/.local/bin/brightness down-all && pkill -RTMIN+9 waybar",
    "tooltip": true
  }
}
