{
    "hyprland/workspaces": {
        "rotate": 0,
        /*"class": "no-margin-padding",*/
        "all-outputs": true,
        "active-only": false,
        "disable-scroll": true,
        "tooltip": false,
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e-1\"})'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e+1\"})'",
        "on-click": "activate",
        "format": "{icon}",
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
            "6": "六",
            "7": "七",
            "8": "八",
            "9": "九",
            "10": "十",
            "urgent": "",
            "focused": "",
            "default": " "
        },
        "persistent-workspaces": {
            "*": 3
        }
    }
}
