{
    "layer": "top",
    "output": [
        "*"
    ],
    "position": "top",
    "mode": "dock",
    "exclusive": true,
    "passthrough": false,
    "reload_style_on_change": true,
    "icon-theme": "Gruvbox-Plus-Dark",

    "height": 50,
    "margin-top": 0,
    "margin-bottom": 0,
    "spacing": 0,
    "include": [
        //"~/.config/waybar/modules.json"
        "modules/*jsonc"
    ],
    "modules-left": [
        "custom/exit",
        "clock",
        "custom/weather",
        "hyprland/window",
        "mpris"
        //"custom/mediaplayer"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "bluetooth",
        "pulseaudio",
        "temperature",
        "network",
        //"cpu",
        //"custom/brightness",
        //"memory",
        //"disk",
        "battery",
        "tray",
        "custom/notification"
    ]
}
