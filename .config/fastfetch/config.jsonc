{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
 "logo": {
  "source": "~/.config/fastfetch/kirby.png",
  "type": "auto",
  "height": 10,
  "width": 29,
  "padding": {
    "top": 1
    }
    },
    "display": {
        "separator": " -> "
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "keyWidth": 10,
			"format": "      \u001b[1m\u001b[35m$(whoami)\u001b[0m\u001b[1m@\u001b[35m$(hostname)\u001b[0m"
        },
        {
            "type": "custom",
            "format": " ─────────────────────────── "
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "yellow"
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "blue"
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "yellow"
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "blue"
        },
        
        {
            "type": "packages",
            "key": "󰏖 ",
            "keyColor": "yellow",
            "disabled": [],
            "extra": []
        },
        
        {
            "type": "memory",
            "key": "󰍛 ",
            "keyColor": "magenta",
            // format: used / total
            "format": "{1} / {2}"
        },
        {
            "type": "uptime",
            "key": "󰔛 ",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "format": " ─────────────────────────── "
        },
        {
            "type": "custom",
            "format": "   \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m  \u001b[90m "
        },
		"break"
    ]
}
