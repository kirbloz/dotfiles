@import '/home/giovanni/.config/swaync/colors/gruvbox-dark.css';


/* Local aliases (colors only) */
/*@define-color fg @grv-fg;
@define-color accent-light @grv-fg;
@define-color selected @grv-active;
@define-color urgent @grv-critical;*/



:root {
  --grv-radius: 10px;
  --grv-transition: 200ms;
  --grv-shadow: rgba(0, 0, 0, 0.35);
  --grv-glow: rgba(250, 189, 47, 0.18);

  --fg: var(--grv-fg);
}


* {
  color: var(--fg);
  border: none;
  box-shadow: none;
  outline: none;
  text-shadow: none;
  font-size: 14px;
  font-family: "Fira Sans Mono";
  transition: var(--grv-transition);
}

.notification-row {
  outline: none;
  margin: 0;
}


/* Notification container */
.floating-notifications.background .notification-row .notification-background {
  background: alpha(var(--bg1), 0.9);
  border: 1px solid var(--bg3);
  border-radius: 8px;
  margin: 6px 0;
  box-shadow: 0 8px 20px var(--grv-shadow);
  padding: 10px;
}

/* Individual notification */
.floating-notifications.background .notification-row .notification-background .notification {
  padding: 6px;
  border-radius: 4px;
}

/* Critical notification */
.floating-notifications.background .notification-row .notification-background .notification.critical {
  border-left: 3px solid var(--grv-critical);
  background: linear-gradient(90deg, alpha(var(--grv-critical), 0.06), transparent);
}

.floating-notifications.background .notification-row .notification-background .notification .notification-content {
  margin: 8px;
}

.floating-notifications.background .notification-row .notification-background .notification > *:last-child > * {
  min-height: 2.4em;
}

.floating-notifications.background .notification-row .notification-background .notification > *:last-child > * .notification-action {
  border-radius: 3px;
  background-color: var(--background-alt) ;
  margin: 6px;
  border: 1px solid transparent;
}

.floating-notifications.background .notification-row .notification-background .notification > *:last-child > * .notification-action:hover {
  background-color: var(--hover);
  border: 1px solid var(--selected);
}

.floating-notifications.background .notification-row .notification-background .notification > *:last-child > * .notification-action:active {
  background-color: var(--selected);
  color: var(--bg0);
}

/* Content */


.image {
  border-radius:6px;
  margin-right:10px;
}

.summary {
  /*color: var(--grv-fg);*/
  font-weight: 700;
  font-size: 1rem;
}

.body {
  color: var(--grv-muted);
  font-size: 0.9rem;
}

/* Action buttons inside notifications */
.floating-notifications.background .notification-row .notification-background .close-button {
  margin: 6px;
  padding: 2px;
  border-radius: 3px;
  background-color: transparent;
  border: 1px solid transparent;
}

.floating-notifications.background .notification-row .notification-background .close-button:hover {
  background-color: var(--selected);
  color: var(--bg0);
}

.floating-notifications.background .notification-row .notification-background .close-button:active {
  background-color: var(--selected);
  color: var(--bg0);
}

/* Progress bars */
.notification.critical progress {
  background-color: var(--grv-active);
}

.notification.low progress,
.notification.normal progress {
  background-color: var(--grv-active);
}


