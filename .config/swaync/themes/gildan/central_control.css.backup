/*@define-color text @accent-light;
@define-color background-alt @bg2;
@define-color selected @accent-bright;
@define-color hover @bg4;
@define-color urgent @critical;*/

@import '/home/giovanni/.config/swaync/colors/gruvbox-dark.css';



@define-color bg0 #282828;
@define-color bg1 #353535;
@define-color bg2 #2a2a2a;
@define-color bg3 #3a3a3a;
@define-color bg4 #4a4a4a;
@define-color accent-bright #EBDBB2;
@define-color text @accent-light;
/* foreground */
@define-color accent-light #EBDBB2;
@define-color accent-mid #b0b0b0;
@define-color accent-dim #808080;
@define-color selected @grv-aqua;
/* selected */
@define-color active #B8BB26;
/* active */
@define-color urgent #FB4934;
/* critical */
@define-color yellow #FABD2F;
@define-color orange #FE8019;
@define-color green #B8BB26;
@define-color aqua #689D6A;
@define-color blue #458588;
@define-color purple #D3869B;
@define-color selected @green;

/* colori (mantieni @define-color) */
@define-color grv-shadow rgba(0, 0, 0, 0.35);
@define-color grv-glow rgba(250, 189, 47, 0.18);


* {
  color: @accent-light;
  all: unset;
  font-size: 14px;
  /*font-family: "JetBrains Mono Nerd Font 10";*/
  transition: 200ms;

  --grv-radius: 10px;
  --grv-transition: 200ms;
}

/* Avoid 'annoying' backgroud */
.blank-window {
  background: transparent;
}

/* CONTROL CENTER ------------------------------------------------------------------------ */

.control-center {
  background: alpha(@grv-bg0, .9);
  /*border-radius: 12px;*/
  border-radius: var(--grv-radius);
  /*border: 1px solid @bg3;*/
  box-shadow: 0 4px 20px @grv-shadow;
  margin: 10px;
  padding: 16px;


  border: 1px solid alpha(@grv-surface-2, 0.6);
  box-shadow: 0 10px 30px @grv-shadow;

  /*transition: background @grv-transition, transform @grv-transition;*/
}

/* Notifications */
.control-center .notification-row .notification-background {
  background-color: @bg2;
  border-radius: 6px;
  margin: 4px 0;
  padding: 4px;
  border: 1px solid @bg0;
}

.control-center .notification-row .notification-background .notification.critical {
  color: @urgent;
  border-left: 2px solid @urgent;
}

.control-center .notification-row .notification-background .notification .notification-content {
  margin: 6px;
  padding: 8px 6px 2px 2px;
}

.control-center .notification-row .notification-background .notification>*:last-child>* {
  min-height: 3.4em;
}

.control-center .notification-row .notification-background .notification>*:last-child>* .notification-action {
  background: alpha(@selected, .15);
  color: @text;
  border-radius: 4px;
  margin: 6px;
  border: 1px solid transparent;
}

.control-center .notification-row .notification-background .notification>*:last-child>* .notification-action:hover {
  background: alpha(@selected, .25);
  border-color: @selected;
}

.control-center .notification-row .notification-background .notification>*:last-child>* .notification-action:active {
  background-color: @selected;
  color: @bg0;
}

/* Buttons */

.control-center .notification-row .notification-background .close-button {
  background: transparent;
  border-radius: 3px;
  color: @text;
  margin: 0;
  padding: 4px;
}

.control-center .notification-row .notification-background .close-button:hover {
  background-color: @selected;
  color: @bg0;
}

.control-center .notification-row .notification-background .close-button:active {
  background-color: @selected;
  color: @bg0;
}

progressbar,
progress,
trough {
  border-radius: 4px;
}

progressbar {
  background-color: rgba(255, 255, 255, .1);
}

/* Notifications expanded-group */

.notification-group {
  margin: 2px 8px;
}

.notification-group-headers {
  font-weight: bold;
  font-size: 1.25rem;
  color: @text;
  letter-spacing: 2px;
}

.notification-group-icon {
  color: @text;
}

.notification-group-collapse-button,
.notification-group-close-all-button {
  background: transparent;
  color: @text;
  margin: 4px;
  border-radius: 3px;
  padding: 4px;
}

.notification-group-collapse-button:hover,
.notification-group-close-all-button:hover {
  background: @hover;
}

/* WIDGETS --------------------------------------------------------------------------- */

/* Notification clear button */
.widget-title {
  font-size: 1rem;
  margin: 12px 0 6px 0;
  padding: 0 4px;
}

.widget-title button {
  background: @background-alt;
  border-radius: 6px;
  padding: 6px 14px;
}

.widget-title button:hover {
  background-color: @hover;
}

.widget-title button:active {
  background-color: @selected;
}

/* Do not disturb */
.widget-dnd {
  margin: 4px 0 8px 0;
  padding: 0 4px;
  font-size: 1rem;
}

.widget-dnd>switch {
  background: @background-alt;
  font-size: initial;
  border-radius: 6px;
  box-shadow: none;
  padding: 4px;
}

.widget-dnd>switch:hover {
  background: @hover;
}

/*
.widget-dnd>switch:checked {
  background: @selected;
}

.widget-dnd>switch:checked:hover {
  background: @hover;
}*/

.widget-dnd>switch.active {
  background: @selected;
}

.widget-dnd>switch.active:hover {
  background: @hover;
}

.widget-dnd>switch slider {
  background: var(--text);
  border-radius: 3px;
}

/* Buttons menu */
.widget-buttons-grid {
  /*font-size: x-large;
  padding: 8px 4px;
  margin: 0 0 8px 0;
  border-radius: 8px;
  background: @background-alt;*/
  background: transparent;
  border-radius: 8px;
  padding: 8px;
}

.widget-buttons-grid>flowbox>flowboxchild>button {
  /*margin: 4px 8px;
  padding: 10px 14px;
  background: transparent;
  border-radius: 6px;*/
  background: var(--grv-surface);
  border: 1px solid alpha(var(--grv-surface-2), 0.6);
  color: var(--grv-fg);
  padding: 10px 14px;
  border-radius: 10px;
  box-shadow: 0 6px 12px alpha(var(--grv-shadow), 0.6);
  transition: transform var(--grv-transition), box-shadow var(--grv-transition);
}

.widget-buttons-grid>flowbox>flowboxchild>button:hover {
  /*background: @hover;*/
  background: var(--grv-active);
  color: var(--grv-bg0);
  transform: translateY(-2px);
  box-shadow: 0 10px 24px var(--grv-glow);
}

/* Toggle button active state */
/*.widget-buttons-grid>flowbox>flowboxchild>button:checked,
.widget-buttons-grid>flowbox>flowboxchild>button.toggle:checked,*/
/*.widget-buttons-grid>flowbox>flowboxchild>button.active,
.widget-buttons-grid>flowbox>flowboxchild>button.toggle.active,
.widget-buttons-grid>flowbox>flowboxchild>button.active {
  background: @selected;
  color: @bg0;
}*/

.widget-buttons-grid>flowbox>flowboxchild>button.active:hover,
.widget-buttons-grid>flowbox>flowboxchild>button.toggle.active:hover {
  background: var(--grv-active);
  color: var(--grv-bg0);
}


/* Music player */
.widget-mpris {
  background: var(--background-alt);
  border-radius: 8px;
  color: var(--grv-fg);
  margin: 8px 0;
  padding: 4px;
}

/* NOTE: Background need *opacity 1* otherwise will turn into the album art blurred  */
.widget-mpris-player {
  background-color: transparent;
  border-radius: 6px;
  padding: 8px 12px;
  margin: 4px;
}

.widget-mpris>box>button {
  color: var(--text);
  border-radius: 6px;
}

.widget-mpris button {
  color: alpha(var(--text), .6);
}

.widget-mpris button:hover {
  color: var(--text);
}

.widget-mpris-album-art {
  border-radius: 6px;
}

.widget-mpris-title {
  font-weight: 700;
  font-size: 1rem;
}

.widget-mpris-subtitle {
  font-weight: 500;
  font-size: 0.8rem;
}

picture.mpris-background {
  opacity: 0;
}

/* Volume */
.widget-volume {
  background: @background-alt;
  padding: 12px 14px;
  margin: 8px 0;
  border-radius: 8px;
}

.widget-volume>box {
  padding: 0;
  margin: 0;
}

.widget-volume label {
  color: @text;
  font-size: 1.2rem;
  margin-right: 8px;
}

.widget-volume button {
  background: transparent;
  color: @text;
  padding: 4px 8px;
  margin-left: 8px;
  border-radius: 3px;
  font-size: 1rem;
}

.widget-volume button:hover {
  background: @hover;
}

/* Per-app volume sliders */
.widget-volume .per-app-volume {
  margin-top: 12px;
  padding-top: 10px;
  border-top: 1px solid var(--bg3);
}

.widget-volume scale trough {
  background: var(--bg3);
  border-radius: 2px;
  min-height: 4px;
  min-width: 200px;
}

.widget-volume scale trough highlight {
  background: var(--selected);
  border-radius: 2px;
}

.widget-volume scale trough slider {
  background: var(--text);
  border-radius: 50%;
  min-height: 12px;
  min-width: 12px;
  margin: -4px 0;
}

/* Backlight */
.widget-backlight {
  background: var(--background-alt);
  padding: 12px 14px;
  margin: 8px 0;
  border-radius: 8px;
}

.widget-backlight>box {
  padding: 0;
  margin: 0;
}

.widget-backlight label {
  color: var(--text);
  font-size: 1.2rem;
  margin-right: 8px;
}

.widget-backlight scale trough {
  background: var(--bg3);
  border-radius: 2px;
  min-height: 4px;
  min-width: 200px;
}

.widget-backlight scale trough highlight {
  background: var(--selected);
  border-radius: 2px;
}

.widget-backlight scale trough slider {
  background: var(--text);
  border-radius: 50%;
  min-height: 12px;
  min-width: 12px;
  margin: -4px 0;
}

/* Power Menu */
.widget-menubar {
  margin: 6px;
}

.widget-menubar {
  margin: 8px 0;
}

/*.widget-menubar>box {
  justify-content: space-between;
}*/
/*GTK usa halign e margin*/

.widget-menubar>box>box {
  background: var(--background-alt);
  border-radius: 8px;
  padding: 2px;
}

.widget-menubar>box>box>button {
  background: transparent;
  color: var(--text);
  padding: 10px 14px;
  margin: 2px;
  border-radius: 6px;
  font-size: 1.2rem;
}

.widget-menubar>box>box>button:hover {
  background: var(--hover);
}

/* Power menu dropdown */
.widget-menubar>revealer>box {
  background: var(--bg2);
  border-radius: 8px;
  padding: 8px;
  margin-top: 8px;
  border: 1px solid @bg3;
}

.widget-menubar>revealer>box>button {
  background: transparent;
  color: var(--text);
  padding: 10px 16px;
  margin: 2px 0;
  border-radius: 6px;
  font-size: 0.95rem;
}

.widget-menubar>revealer>box>button:hover {
  background: var(--hover);
}

.widget-menubar>revealer>box>button:active {
  background: var(--selected);
  color: va(--bg0);
}

/* No Notifications placeholder */
.control-center .notification-row:empty {
  min-height: 80px;
}

.notification-placeholder {
  opacity: 0.4;
  font-size: 0.9rem;
}

/* Label widget (spacer) */
.widget-label {
  margin: 0;
  padding: 0;
  font-size: 0.1rem;
}